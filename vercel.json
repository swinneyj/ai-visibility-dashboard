{
  "buildCommand": "pip install -r requirements.txt",
  "installCommand": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.py" }
  ],
  "functions": {
    "api/index.py": {
      "runtime": "python3.12",
      "memory": 512,
      "maxDuration": 60
    }
  }
}
